---
import { siteConfig } from "../config";
---
<section id="education" class="section-shell section-split" aria-labelledby="education-title">
  <div class="section-heading"><p class="eyebrow">04 / 教育经历</p><h2 id="education-title">Education<span class="section-period">.</span></h2><div class="section-rule"></div></div>
  <div class="section-content education-list">{siteConfig.education.map(edu => <article class="education-item">
    <div class="education-top"><span class="mono education-date">{edu.dateRange}</span>{edu.current && <span class="current-label"><span class="status-dot" aria-hidden="true"></span>在读</span>}</div>
    <h3>{edu.school}</h3><p class="school-english" lang="en">{edu.englishSchool}</p><p class="education-college">{edu.college}</p><p class="education-degree">{edu.degree}</p>
    {"academicStats" in edu && edu.academicStats && <dl class="education-stats" aria-label="本科学业与奖学金">
      {edu.academicStats.map(stat => <div><dt>{stat.label}</dt><dd><strong>{stat.value}</strong><span>{stat.suffix}</span></dd></div>)}
    </dl>}
    {"honors" in edu && edu.honors && <ul class="education-honors" aria-label="本科代表性荣誉">{edu.honors.map(honor => <li>{honor}</li>)}</ul>}
  </article>)}</div>
</section>
