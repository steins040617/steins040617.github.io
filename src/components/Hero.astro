---
import { siteConfig } from "../config";
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div><div class="hero-inner">
    <p class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span>HARDWARE · SYSTEMS · VERIFICATION</p>
    <p class="hero-greeting">你好，我是</p>
    <h1 id="hero-title">{siteConfig.name}<span class="hero-name-en" lang="en">{siteConfig.englishName}<span class="name-period">.</span></span></h1>
    <p class="hero-title">{siteConfig.title}</p>
    <p class="hero-description">从 FPGA 系统实践，到智能化硬件验证。<br />这里记录我的项目、论文与学习经历。</p>
    <div class="hero-actions"><a class="button button-primary" href="#projects">查看项目 <span aria-hidden="true">↓</span></a><a class="button button-text" href="#publications">研究论文 <span aria-hidden="true">↗</span></a></div>
    <div class="hero-topics" aria-label="项目与研究方向">{siteConfig.skills.map(skill => <span>{skill}</span>)}</div>
  </div>
  <div class="hero-bottom"><span class="mono">HANYUAN LIU / PERSONAL WEBSITE</span><a href="#about">向下了解 <span aria-hidden="true">↓</span></a></div>
</section>
